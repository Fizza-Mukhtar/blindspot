# ---------------------------------------------------------------------------
# Blindspot model access.  Copy to `.env`.  `.env` is gitignored and MUST NOT
# be included in any submission archive (Rule Book #08).
#
# You only need ONE of the options below.  Reproducing the published results
# needs NONE of them — `make reproduce` replays committed cassettes offline.
# ---------------------------------------------------------------------------

# Option A — Claude subscription (Pro/Max) via the Claude Code CLI.
# Get a long-lived token with:  claude setup-token
# Then:  BLINDSPOT_PROVIDER=claude_cli
CLAUDE_CODE_OAUTH_TOKEN=

# Option B — Anthropic API key (pay-as-you-go).
# Then:  BLINDSPOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option C — OpenAI-compatible endpoint (cross-model generalisation runs).
# Then:  BLINDSPOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Provider selection.  `replay` (the default) needs no credentials at all.
#   replay      deterministic playback of committed cassettes  [default]
#   claude_cli  Claude Code CLI in headless mode
#   anthropic   Anthropic Messages API
#   openai      OpenAI-compatible Chat Completions API
#   mock        offline deterministic stub, used by the unit tests
# ---------------------------------------------------------------------------
BLINDSPOT_PROVIDER=replay

# Absolute path to the Claude Code executable, if it is not on PATH.
# CLAUDE_CODE_PATH=
